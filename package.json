{
  "name": "amazon-ynab-sync",
  "version": "1.0.0",
  "description": "Amazon to YNAB Sync with React UI",
  "main": "server.ts",
  "scripts": {
    "dev": "concurrently \"npm run server:watch\" \"npm run client\"",
    "server": "npx ts-node server.ts",
    "server:watch": "node --watch -r ts-node/register server.ts",
    "client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "typecheck": "tsc --noEmit",
    "test": "node --test -r ts-node/register tests/*.test.ts",
    "login": "npx ts-node login.ts",
    "sync": "npx ts-node transactions-to-json.ts",
    "ynab": "npx ts-node ynab-sync.ts"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "openai": "^7.0.0",
    "playwright": "^1.62.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "baseline-browser-mapping": "^2.11.5",
    "concurrently": "^10.0.4",
    "ts-node": "^10.9.2"
  }
}
