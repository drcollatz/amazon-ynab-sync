# YNAB API Configuration
# Get your token from: https://app.youneedabudget.com/settings/developer
YNAB_TOKEN=your_ynab_personal_access_token_here

# YNAB Budget ID - can be "last-used" or specific budget ID
# Find your budget ID in YNAB URL or API
YNAB_BUDGET_ID=last-used

# YNAB Account ID for Amazon transactions
# Get this from YNAB API or check your account settings
YNAB_ACCOUNT_ID=your_account_id_here

# Script Configuration
# Set to 1 for testing without sending data to YNAB
DRY_RUN=0

# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Specify fallback model if gpt-5-nano is not available
# OPENAI_FALLBACK_MODEL=gpt-4o-mini

# Server Configuration
# API server defaults to localhost only.
PORT=3001
HOST=127.0.0.1

# Optional: protect all /api routes with a shared token.
# If set, also set VITE_API_AUTH_TOKEN in client/.env.local to the same value.
# API_AUTH_TOKEN=generate_a_long_random_token

# Optional comma-separated allowed browser origins for CORS.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Optional robustness/debug tuning
# SCRIPT_TIMEOUT_MS=1800000
# LOGIN_SCRIPT_TIMEOUT_MS=600000
# YNAB_SCRIPT_TIMEOUT_MS=180000
# YNAB_HTTP_TIMEOUT_MS=15000
# API_DEBUG_OUTPUT=0
# DEBUG_SCRAPER=0
# DEBUG_SYNC=0
# MAX_LOAD_MORE_CLICKS=8
# MAX_TRANSACTION_SCROLL_STEPS=80